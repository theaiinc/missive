# The Missive API for hosting (Cloudflare Containers, see packages/edge).
# Build from the repo root: docker build -f Dockerfile.backend .

FROM node:22-bookworm-slim AS build
RUN npm install -g pnpm@9.15.0
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --filter "@theaiinc/missive-backend..." \
 && pnpm --filter @theaiinc/missive-core run build \
 && pnpm --filter @theaiinc/missive-backend run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=4000
WORKDIR /repo
# The whole workspace, so the backend's link to packages/core (and its dist)
# resolves as it does in development. Migrations are read from
# packages/backend/src/storage/migrations (see PostgresService.migrationDir).
COPY --from=build /repo /repo
USER node
EXPOSE 4000
WORKDIR /repo/packages/backend
CMD ["node", "dist/main.js"]
