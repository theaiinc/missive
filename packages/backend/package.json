    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@theaiinc/missive-core": "workspace:*",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "imapflow": "^1.3.7",
    "mailparser": "^3.9.9",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
