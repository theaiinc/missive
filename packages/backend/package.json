  "private": true,
  "description": "Missive NestJS backend",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && concurrently -k -n compile,run \"tsc --watch\" \"node --watch dist/main.js\"",
