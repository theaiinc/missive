# AI / LM Studio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen3-4b-z-image-engineer-v4
# LM Studio request timeout in ms (default 120000)
LM_STUDIO_TIMEOUT_MS=120000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missive
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
CORS_ORIGIN=http://localhost:5173
PORT=4000

# Gmail OAuth
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:5173/oauth


# Outlook / Microsoft Graph OAuth
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:5173/oauth
OUTLOOK_TENANT=your-tenant-id