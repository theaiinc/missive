{
  "name": "@theaiinc/missive",
  "version": "0.1.0",
  "private": true,
  "description": "Communication Intelligence Layer — unify, search, and reason over all your communications",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "google-auth-library": "10.7.0"
    }
  },
  "devDependencies": {
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}